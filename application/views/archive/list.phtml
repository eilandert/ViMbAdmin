{tmplinclude file="header.phtml"}

{if isset( $session->domain ) && $session->domain }
    {assign var=domain value=$session->domain}
{/if}

<div class="page-content" >

    <div class="page-header" >
        <h1>
            Archives {if isset( $domain ) && $domain}<small> for {$domain->requiredDomainName()} {if $domain->getMaxMailboxes() != 0}({$domain->getMailboxCount()}/{$domain->getMaxMailboxes()}){/if}</small>
                <a class="btn have-tooltip-below" id="show_all_archives" title="Show All" href="{genUrl controller='archive' action='list' unset=1}">
                    <i class="bi-x-circle"></i>
                </a>
            {/if}
        </h1>
    </div>

{OSS_Message}

<table id="list_table" cellpadding="0" cellspacing="0" border="0" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Username</th>
            <th>Status</th>
            <th>Domain</th>
            <th>Size</th>
            <th>Archived</th>
            <th>User exists</th>
            <th>Autoprune</th>
            <th width="180"></th>
        </tr>
    </thead>
    <tbody>
{foreach $archives as $archive}
        <tr>
            <td>{$archive.username}</td>
            <td>{$statuses[$archive.status]}</td>
            <td>{$archive.domain}</td>
            <td>{if $archive.maildir_size}{$archive.maildir_size|filesize}{else}&mdash;{/if}</td>
            <td>{if $archive.archived_at}{$archive.archived_at->format('Y-m-d H:i')}{else}&mdash;{/if}</td>
            <td>{if $archive.user_exists}<span class="badge text-bg-success">Yes</span>{else}<span class="badge text-bg-secondary">No</span>{/if}</td>
            <td>{if $archive.autoprune}<span class="badge text-bg-warning">On</span>{else}<span class="badge text-bg-secondary">Off</span>{/if}</td>
            <td>
                <div class="btn-group">
                    {if $archive.status|in_array:$allowRestore}
                        <form method="post" action="{genUrl controller='archive' action='restore'}" class="archive-action-form" style="display: inline;"
                              data-confirm="Restore {$archive.username|escape}? Recreates the mailbox if it was deleted, syncs the backed-up mail back, then removes the backup.">
                            <input type="hidden" name="arid" value="{$archive.id}" />
                            <input type="hidden" name="csrf" value="{$csrfToken|escape}" />
                            <button class="btn btn-sm have-tooltip" id="restore-archive-{$archive.id}" title="Restore mail back into the mailbox" type="submit">
                                <i class="bi-arrow-repeat"></i>
                            </button>
                        </form>
                    {/if}
                    {if $archive.status|in_array:$allowDelete}
                        <form method="post" action="{genUrl controller='archive' action='delete'}" class="archive-action-form" style="display: inline;"
                              data-confirm="Permanently delete the backup for {$archive.username|escape}? This removes the /backups maildir and cannot be undone.">
                            <input type="hidden" name="arid" value="{$archive.id}" />
                            <input type="hidden" name="csrf" value="{$csrfToken|escape}" />
                            <button class="btn btn-sm btn-danger have-tooltip" id="delete-archive-{$archive.id}" title="Delete backup permanently" type="submit">
                                <i class="bi-trash"></i>
                            </button>
                        </form>
                    {/if}
                    {if $archive.autoprune}
                        <form method="post" action="{genUrl controller='archive' action='toggle-autoprune'}" class="archive-action-form" style="display: inline;"
                              data-confirm="Disable autoprune for {$archive.username|escape}? Its backup will no longer expire automatically.">
                            <input type="hidden" name="arid" value="{$archive.id}" />
                            <input type="hidden" name="csrf" value="{$csrfToken|escape}" />
                            <button class="btn btn-sm have-tooltip" id="autoprune-archive-{$archive.id}" title="Disable autoprune" type="submit">
                                <i class="bi-power"></i>
                            </button>
                        </form>
                    {else}
                        <form method="post" action="{genUrl controller='archive' action='toggle-autoprune'}" class="archive-action-form" style="display: inline;"
                              data-confirm="Enable autoprune for {$archive.username|escape}? This resets its archived date to now, so the prune window restarts.">
                            <input type="hidden" name="arid" value="{$archive.id}" />
                            <input type="hidden" name="csrf" value="{$csrfToken|escape}" />
                            <button class="btn btn-sm btn-warning have-tooltip" id="autoprune-archive-{$archive.id}" title="Enable autoprune (resets archived date to now)" type="submit">
                                <i class="bi-clock-history"></i>
                            </button>
                        </form>
                    {/if}
                </div>
            </td>
        </tr>
{/foreach}
    </tbody>
</table>

<br />
<br />

<script type="text/javascript" nonce="{$cspNonce}">{tmplinclude file='archive/js/list.js'}</script>

</div>

{tmplinclude file="footer.phtml"}
